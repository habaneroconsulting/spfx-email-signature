{
  "name": "spfx-email-signatures",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "heft build --clean",
    "clean": "heft clean",
    "dev": "heft build --clean && heft package-solution",
    "dist": "heft build --clean --production && heft package-solution --production",
    "eject-webpack": "heft eject-webpack",
    "lint": "eslint src",
    "package-solution": "heft package-solution",
    "postversion": "git push && git push --tags",
    "prettier": "prettier --write {config,scripts,src}/**/*",
    "preversion": "node ./scripts/preversion.js $npm_package_version %npm_package_version% && git add .",
    "serve": "heft start --clean --nobrowser",
    "serve:browser": "heft start --clean",
    "start": "heft start --clean",
    "test": "jest --coverage",
    "test:watch": "jest --coverage --watchAll",
    "version-major": "npm version major -m \"Major version bump to %s\"",
    "version-minor": "npm version minor -m \"Minor version bump to %s\"",
    "version-patch": "npm version patch -m \"Patch version bump to %s\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@fluentui/react": "8.125.8",
    "@microsoft/microsoft-graph-client": "3.0.2",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@pnp/spfx-property-controls": "3.24.0",
    "canvas": "3.2.3",
    "clipboard-polyfill": "4.1.1",
    "mustache": "4.2.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-transition-group": "4.4.5",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "12.1.5",
    "@types/jest": "30.0.0",
    "@types/mustache": "4.2.6",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/react-transition-group": "4.4.12",
    "@types/webpack-env": "1.18.8",
    "css-loader": "7.1.5",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-transform-stub": "2.0.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.8.3",
    "webpack-bundle-analyzer": "5.4.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "json",
      "lcov",
      "text-summary",
      "cobertura"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "moduleNameMapper": {
      "@fluentui/react/lib/(.*)$": "@fluentui/react/lib-commonjs/$1",
      "^@msinternal/ecs-flight$": "jest-transform-stub",
      "^@msinternal/odsp-core-bundle(/.*)?$": "jest-transform-stub",
      "^.+\\.(resx)$": "jest-transform-stub"
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "suiteName": "SPFx unit test",
          "outputDirectory": "./reports/",
          "outputName": "./junit.xml"
        }
      ]
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "testEnvironment": "jsdom",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(ts?|tsx?)$",
    "transform": {
      "^.+\\.(js|ts|tsx)$": "ts-jest",
      "^.+\\.(resx)$": "jest-transform-stub"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@microsoft/sp-core-library/.*))"
    ]
  }
}
